# Frontend
VITE_API_BASE=http://localhost:5000

# ── Android build ──────────────────────────────────────────────────────────────
# For Android emulator use 10.0.2.2 (alias for your PC's localhost)
# For real device on same WiFi, replace with your PC's local IP e.g. 192.168.1.x
# To build for Android:  copy this line over VITE_API_BASE before running npm run build
# VITE_API_BASE=http://10.0.2.2:5000

# Backend (set these before running in production)
SECRET_KEY=ai-health-secret-change-in-production-2024
FLASK_ENV=development
PORT=5000
ALLOWED_ORIGINS=*
