# Frontend
VITE_API_BASE=http://localhost:5000

# ── Android build ──────────────────────────────────────────────────────────────
# For Android emulator use 10.0.2.2 (alias for your PC's localhost)
# For real device on same WiFi, replace with your PC's local IP e.g. 192.168.1.x
# VITE_API_BASE=http://10.0.2.2:5000

# ── Backend ────────────────────────────────────────────────────────────────────
# SECURITY: Change SECRET_KEY to a long random string before deploying.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ai-health-secret-change-in-production-2024

FLASK_ENV=development
PORT=5000

# SECURITY: Change ALLOWED_ORIGINS to your frontend domain before deploying.
# Example: ALLOWED_ORIGINS=https://yourdomain.com
ALLOWED_ORIGINS=*
